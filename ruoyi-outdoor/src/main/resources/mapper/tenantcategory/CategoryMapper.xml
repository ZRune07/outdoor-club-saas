<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.outdoor.tenantcategory.mapper.CategoryMapper">

    <resultMap type="Category" id="CategoryResult">
        <id     property="id"         column="id"          />
        <result property="clubId"     column="club_id"     />
        <result property="parentId"   column="parent_id"   />
        <result property="name"       column="name"        />
        <result property="sort"       column="sort"        />
        <result property="status"     column="status"      />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectCategoryVo">
        select id, club_id, parent_id, name, sort, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from outdoor_category
    </sql>

    <select id="selectCategoryListByClubId" parameterType="Long" resultMap="CategoryResult">
        <include refid="selectCategoryVo"/>
        where del_flag = '0' and club_id = #{clubId}
        order by sort asc, id asc
    </select>

    <select id="selectCategoryById" parameterType="Long" resultMap="CategoryResult">
        <include refid="selectCategoryVo"/>
        where id = #{id}
    </select>

</mapper>
