<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.outdoor.payment.mapper.PaymentMapper">
    
    <resultMap type="com.ruoyi.outdoor.payment.domain.Payment" id="PaymentResult">
        <id property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="clubId" column="club_id"/>
        <result property="registrationId" column="registration_id"/>
        <result property="wxUserId" column="wx_user_id"/>
        <result property="orderType" column="order_type"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="discountAmount" column="discount_amount"/>
        <result property="payAmount" column="pay_amount"/>
        <result property="payStatus" column="pay_status"/>
        <result property="payTime" column="pay_time"/>
        <result property="transactionId" column="transaction_id"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="activityTitle" column="activity_title"/>
        <result property="realName" column="real_name"/>
        <result property="phone" column="phone"/>
    </resultMap>

    <sql id="selectPaymentVo">
        SELECT o.order_id, o.order_no, o.club_id, o.registration_id, o.wx_user_id, 
               o.order_type, o.total_amount, o.discount_amount, o.pay_amount, 
               o.pay_status, o.pay_time, o.transaction_id, 
               o.create_by, o.create_time, o.update_by, o.update_time, o.remark,
               a.activity_title, r.real_name, r.phone
        FROM pay_order o
        LEFT JOIN act_activity a ON o.registration_id = a.activity_id
        LEFT JOIN reg_registration r ON o.registration_id = r.registration_id
    </sql>

    <select id="selectPaymentByOrderId" parameterType="Long" resultMap="PaymentResult">
        <include refid="selectPaymentVo"/>
        WHERE o.order_id = #{orderId}
    </select>

    <select id="selectPaymentByOrderNo" parameterType="String" resultMap="PaymentResult">
        <include refid="selectPaymentVo"/>
        WHERE o.order_no = #{orderNo}
    </select>

    <select id="selectPaymentByRegistrationId" parameterType="Long" resultMap="PaymentResult">
        <include refid="selectPaymentVo"/>
        WHERE o.registration_id = #{registrationId}
    </select>

    <select id="selectPaymentListByUserId" parameterType="Long" resultMap="PaymentResult">
        <include refid="selectPaymentVo"/>
        WHERE o.wx_user_id = #{wxUserId}
        ORDER BY o.create_time DESC
    </select>

    <select id="selectPaymentList" parameterType="com.ruoyi.outdoor.payment.domain.Payment" resultMap="PaymentResult">
        <include refid="selectPaymentVo"/>
        <where>
            <if test="clubId != null">
                AND o.club_id = #{clubId}
            </if>
            <if test="wxUserId != null">
                AND o.wx_user_id = #{wxUserId}
            </if>
            <if test="payStatus != null and payStatus != ''">
                AND o.pay_status = #{payStatus}
            </if>
            <if test="orderType != null and orderType != ''">
                AND o.order_type = #{orderType}
            </if>
        </where>
        ORDER BY o.create_time DESC
    </select>

    <insert id="insertPayment" parameterType="com.ruoyi.outdoor.payment.domain.Payment" useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO pay_order (
            <if test="orderNo != null">order_no,</if>
            <if test="clubId != null">club_id,</if>
            <if test="registrationId != null">registration_id,</if>
            <if test="wxUserId != null">wx_user_id,</if>
            <if test="orderType != null">order_type,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="discountAmount != null">discount_amount,</if>
            <if test="payAmount != null">pay_amount,</if>
            <if test="payStatus != null">pay_status,</if>
            <if test="transactionId != null">transaction_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark</if>
        ) VALUES (
            <if test="orderNo != null">#{orderNo},</if>
            <if test="clubId != null">#{clubId},</if>
            <if test="registrationId != null">#{registrationId},</if>
            <if test="wxUserId != null">#{wxUserId},</if>
            <if test="orderType != null">#{orderType},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="discountAmount != null">#{discountAmount},</if>
            <if test="payAmount != null">#{payAmount},</if>
            <if test="payStatus != null">#{payStatus},</if>
            <if test="transactionId != null">#{transactionId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark}</if>
        )
    </insert>

    <update id="updatePayment" parameterType="com.ruoyi.outdoor.payment.domain.Payment">
        UPDATE pay_order
        <set>
            <if test="payStatus != null">pay_status = #{payStatus},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="transactionId != null">transaction_id = #{transactionId},</if>
            <if test="payAmount != null">pay_amount = #{payAmount},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE order_id = #{orderId}
    </update>

    <delete id="deletePaymentByOrderId" parameterType="Long">
        DELETE FROM pay_order WHERE order_id = #{orderId}
    </delete>
</mapper>
