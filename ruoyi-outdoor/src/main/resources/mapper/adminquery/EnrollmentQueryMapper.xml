<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.outdoor.adminquery.mapper.EnrollmentQueryMapper">

    <resultMap type="com.ruoyi.outdoor.adminquery.domain.EnrollmentView" id="EnrollmentViewResult">
        <id     property="registrationId"   column="registration_id"   />
        <result property="clubId"           column="club_id"           />
        <result property="activityId"       column="activity_id"       />
        <result property="wxUserId"         column="wx_user_id"        />
        <result property="realName"         column="real_name"         />
        <result property="phone"            column="phone"             />
        <result property="idCard"           column="id_card"           />
        <result property="emergencyContact" column="emergency_contact" />
        <result property="emergencyPhone"   column="emergency_phone"   />
        <result property="status"           column="status"            />
        <result property="activityTitle"    column="activity_title"    />
        <result property="createTime"       column="create_time"       />
    </resultMap>

    <sql id="selectEnrollmentVo">
        select r.registration_id, r.club_id, r.activity_id, r.wx_user_id, r.real_name,
               r.phone, r.id_card, r.emergency_contact, r.emergency_phone, r.status,
               r.create_time, a.activity_title
        from reg_registration r
        left join act_activity a on r.activity_id = a.activity_id
    </sql>

    <select id="selectEnrollments" resultMap="EnrollmentViewResult">
        <include refid="selectEnrollmentVo"/>
        <where>
            r.club_id = #{clubId}
            <if test="status != null and status != ''">and r.status = #{status}</if>
        </where>
        order by r.create_time desc
    </select>

    <select id="selectEnrollmentById" resultMap="EnrollmentViewResult">
        <include refid="selectEnrollmentVo"/>
        where r.registration_id = #{registrationId}
    </select>

    <update id="updateEnrollmentStatus">
        update reg_registration
        set status = #{status}, update_time = CURRENT_TIMESTAMP
        where registration_id = #{registrationId} and club_id = #{clubId}
    </update>

</mapper>
