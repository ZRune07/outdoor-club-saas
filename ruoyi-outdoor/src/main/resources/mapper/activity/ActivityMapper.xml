<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.outdoor.activity.mapper.ActivityMapper">
    
    <resultMap type="Activity" id="ActivityResult">
        <id     property="activityId"       column="activity_id"       />
        <result property="clubId"           column="club_id"           />
        <result property="activityName"     column="activity_name"     />
        <result property="activityType"     column="activity_type"     />
        <result property="coverImage"       column="cover_image"       />
        <result property="summary"          column="summary"           />
        <result property="content"          column="content"           />
        <result property="startTime"      column="start_time"        />
        <result property="endTime"        column="end_time"          />
        <result property="deadline"        column="deadline"          />
        <result property="location"         column="location"          />
        <result property="longitude"        column="longitude"         />
        <result property="latitude"         column="latitude"          />
        <result property="maxParticipants" column="max_participants"  />
        <result property="participantCount" column="participant_count" />
        <result property="fee"            column="fee"               />
        <result property="feeNote"         column="fee_note"          />
        <result property="contactName"    column="contact_name"      />
        <result property="contactPhone"   column="contact_phone"     />
        <result property="status"           column="status"            />
        <result property="isTop"           column="is_top"            />
        <result property="delFlag"         column="del_flag"          />
        <result property="createBy"       column="create_by"         />
        <result property="createTime"     column="create_time"       />
        <result property="updateBy"       column="update_by"         />
        <result property="updateTime"     column="update_time"       />
        <result property="remark"         column="remark"            />
    </resultMap>

    <sql id="selectActivityVo">
        select activity_id, club_id, activity_name, activity_type, cover_image, summary, content, start_time, end_time, deadline, location, longitude, latitude, max_participants, participant_count, fee, fee_note, contact_name, contact_phone, status, is_top, del_flag, create_by, create_time, update_by, update_time, remark from outdoor_activity
    </sql>

    <select id="selectActivityList" parameterType="Activity" resultMap="ActivityResult">
        <include refid="selectActivityVo"/>
        <where>  
            del_flag = '0'
            <if test="clubId != null "> and club_id = #{clubId}</if>
            <if test="activityName != null  and activityName != ''"> and activity_name like concat('%', #{activityName}, '%')</if>
            <if test="activityType != null  and activityType != ''"> and activity_type = #{activityType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="isTop != null  and isTop != ''"> and is_top = #{isTop}</if>
        </where>
        order by is_top desc, create_time desc
    </select>
    
    <select id="selectActivityByActivityId" parameterType="Long" resultMap="ActivityResult">
        <include refid="selectActivityVo"/>
        where activity_id = #{activityId}
    </select>
        
    <insert id="insertActivity" parameterType="Activity" useGeneratedKeys="true" keyProperty="activityId">
        insert into outdoor_activity
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="clubId != null">club_id,</if>
            <if test="activityName != null and activityName != ''">activity_name,</if>
            <if test="activityType != null">activity_type,</if>
            <if test="coverImage != null">cover_image,</if>
            <if test="summary != null">summary,</if>
            <if test="content != null">content,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="deadline != null">deadline,</if>
            <if test="location != null">location,</if>
            <if test="longitude != null">longitude,</if>
            <if test="latitude != null">latitude,</if>
            <if test="maxParticipants != null">max_participants,</if>
            <if test="participantCount != null">participant_count,</if>
            <if test="fee != null">fee,</if>
            <if test="feeNote != null">fee_note,</if>
            <if test="contactName != null">contact_name,</if>
            <if test="contactPhone != null">contact_phone,</if>
            <if test="status != null">status,</if>
            <if test="isTop != null">is_top,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="clubId != null">#{clubId},</if>
            <if test="activityName != null and activityName != ''">#{activityName},</if>
            <if test="activityType != null">#{activityType},</if>
            <if test="coverImage != null">#{coverImage},</if>
            <if test="summary != null">#{summary},</if>
            <if test="content != null">#{content},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="deadline != null">#{deadline},</if>
            <if test="location != null">#{location},</if>
            <if test="longitude != null">#{longitude},</if>
            <if test="latitude != null">#{latitude},</if>
            <if test="maxParticipants != null">#{maxParticipants},</if>
            <if test="participantCount != null">#{participantCount},</if>
            <if test="fee != null">#{fee},</if>
            <if test="feeNote != null">#{feeNote},</if>
            <if test="contactName != null">#{contactName},</if>
            <if test="contactPhone != null">#{contactPhone},</if>
            <if test="status != null">#{status},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateActivity" parameterType="Activity">
        update outdoor_activity
        <trim prefix="SET" suffixOverrides=",">
            <if test="clubId != null">club_id = #{clubId},</if>
            <if test="activityName != null and activityName != ''">activity_name = #{activityName},</if>
            <if test="activityType != null">activity_type = #{activityType},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="content != null">content = #{content},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="deadline != null">deadline = #{deadline},</if>
            <if test="location != null">location = #{location},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="maxParticipants != null">max_participants = #{maxParticipants},</if>
            <if test="participantCount != null">participant_count = #{participantCount},</if>
            <if test="fee != null">fee = #{fee},</if>
            <if test="feeNote != null">fee_note = #{feeNote},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="status != null">status = #{status},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where activity_id = #{activityId}
    </update>

    <update id="deleteActivityByActivityId" parameterType="Long">
        update outdoor_activity set del_flag = '2' where activity_id = #{activityId}
    </update>

    <update id="deleteActivityByActivityIds" parameterType="Long">
        update outdoor_activity set del_flag = '2' where activity_id in 
        <foreach item="activityId" collection="array" open="(" separator="," close=")">
            #{activityId}
        </foreach>
    </update>
</mapper>
