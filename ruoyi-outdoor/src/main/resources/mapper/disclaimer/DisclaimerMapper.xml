<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.outdoor.disclaimer.mapper.DisclaimerMapper">
    
    <resultMap type="Disclaimer" id="DisclaimerResult">
        <id     property="disclaimerId"     column="disclaimer_id"     />
        <result property="clubId"           column="club_id"           />
        <result property="activityId"       column="activity_id"       />
        <result property="wxUserId"         column="wx_user_id"        />
        <result property="signerName"       column="signer_name"       />
        <result property="idCard"           column="id_card"           />
        <result property="phone"            column="phone"             />
        <result property="status"           column="status"            />
        <result property="signTime"         column="sign_time"         />
        <result property="delFlag"          column="del_flag"          />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
    </resultMap>

    <sql id="selectDisclaimerVo">
        select disclaimer_id, club_id, activity_id, wx_user_id, signer_name, id_card, phone, status, sign_time, del_flag, create_by, create_time, update_by, update_time, remark from outdoor_disclaimer
    </sql>

    <select id="selectDisclaimerList" parameterType="Disclaimer" resultMap="DisclaimerResult">
        <include refid="selectDisclaimerVo"/>
        <where>  
            del_flag = '0'
            <if test="clubId != null "> and club_id = #{clubId}</if>
            <if test="activityId != null "> and activity_id = #{activityId}</if>
            <if test="wxUserId != null "> and wx_user_id = #{wxUserId}</if>
            <if test="signerName != null  and signerName != ''"> and signer_name like concat('%', #{signerName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectDisclaimerByDisclaimerId" parameterType="Long" resultMap="DisclaimerResult">
        <include refid="selectDisclaimerVo"/>
        where disclaimer_id = #{disclaimerId}
    </select>
        
    <insert id="insertDisclaimer" parameterType="Disclaimer" useGeneratedKeys="true" keyProperty="disclaimerId">
        insert into outdoor_disclaimer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="clubId != null">club_id,</if>
            <if test="activityId != null">activity_id,</if>
            <if test="wxUserId != null">wx_user_id,</if>
            <if test="signerName != null and signerName != ''">signer_name,</if>
            <if test="idCard != null">id_card,</if>
            <if test="phone != null">phone,</if>
            <if test="status != null">status,</if>
            <if test="signTime != null">sign_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="clubId != null">#{clubId},</if>
            <if test="activityId != null">#{activityId},</if>
            <if test="wxUserId != null">#{wxUserId},</if>
            <if test="signerName != null and signerName != ''">#{signerName},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="phone != null">#{phone},</if>
            <if test="status != null">#{status},</if>
            <if test="signTime != null">#{signTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDisclaimer" parameterType="Disclaimer">
        update outdoor_disclaimer
        <trim prefix="SET" suffixOverrides=",">
            <if test="clubId != null">club_id = #{clubId},</if>
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="wxUserId != null">wx_user_id = #{wxUserId},</if>
            <if test="signerName != null">signer_name = #{signerName},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="status != null">status = #{status},</if>
            <if test="signTime != null">sign_time = #{signTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where disclaimer_id = #{disclaimerId}
    </update>

    <update id="deleteDisclaimerByDisclaimerId" parameterType="Long">
        update outdoor_disclaimer set del_flag = '2' where disclaimer_id = #{disclaimerId}
    </update>

    <update id="deleteDisclaimerByDisclaimerIds" parameterType="Long">
        update outdoor_disclaimer set del_flag = '2' where disclaimer_id in 
        <foreach item="disclaimerId" collection="array" open="(" separator="," close=")">
            #{disclaimerId}
        </foreach>
    </update>
</mapper>
