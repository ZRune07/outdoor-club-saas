<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.outdoor.disclaimer.mapper.DisclaimerMapper">
    
    <resultMap type="com.ruoyi.outdoor.disclaimer.domain.Disclaimer" id="DisclaimerResult">
        <id property="disclaimerId" column="disclaimer_id"/>
        <result property="clubId" column="club_id"/>
        <result property="disclaimerTitle" column="disclaimer_title"/>
        <result property="disclaimerType" column="disclaimer_type"/>
        <result property="content" column="content"/>
        <result property="version" column="version"/>
        <result property="status" column="status"/>
        <result property="effectiveTime" column="effective_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="clubName" column="club_name"/>
    </resultMap>

    <sql id="selectDisclaimerVo">
        SELECT d.disclaimer_id, d.club_id, d.disclaimer_title, d.disclaimer_type, 
               d.content, d.version, d.status, d.effective_time,
               d.create_by, d.create_time, d.update_by, d.update_time, d.remark,
               c.club_name
        FROM dis_disclaimer d
        LEFT JOIN club c ON d.club_id = c.club_id
    </sql>

    <select id="selectDisclaimerByDisclaimerId" parameterType="Long" resultMap="DisclaimerResult">
        <include refid="selectDisclaimerVo"/>
        WHERE d.disclaimer_id = #{disclaimerId}
    </select>

    <select id="selectActiveDisclaimerByClubId" parameterType="Long" resultMap="DisclaimerResult">
        <include refid="selectDisclaimerVo"/>
        WHERE d.club_id = #{clubId}
          AND d.status = 'active'
          AND (d.effective_time IS NULL OR d.effective_time &lt;= CURRENT_TIMESTAMP)
        ORDER BY d.effective_time DESC
        LIMIT 1
    </select>

    <select id="selectDisclaimerList" parameterType="com.ruoyi.outdoor.disclaimer.domain.Disclaimer" resultMap="DisclaimerResult">
        <include refid="selectDisclaimerVo"/>
        <where>
            <if test="clubId != null">
                AND d.club_id = #{clubId}
            </if>
            <if test="disclaimerType != null and disclaimerType != ''">
                AND d.disclaimer_type = #{disclaimerType}
            </if>
            <if test="status != null and status != ''">
                AND d.status = #{status}
            </if>
        </where>
        ORDER BY d.create_time DESC
    </select>

    <insert id="insertDisclaimer" parameterType="com.ruoyi.outdoor.disclaimer.domain.Disclaimer" useGeneratedKeys="true" keyProperty="disclaimerId">
        INSERT INTO dis_disclaimer (
            <if test="clubId != null">club_id,</if>
            <if test="disclaimerTitle != null">disclaimer_title,</if>
            <if test="disclaimerType != null">disclaimer_type,</if>
            <if test="content != null">content,</if>
            <if test="version != null">version,</if>
            <if test="status != null">status,</if>
            <if test="effectiveTime != null">effective_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark</if>
        ) VALUES (
            <if test="clubId != null">#{clubId},</if>
            <if test="disclaimerTitle != null">#{disclaimerTitle},</if>
            <if test="disclaimerType != null">#{disclaimerType},</if>
            <if test="content != null">#{content},</if>
            <if test="version != null">#{version},</if>
            <if test="status != null">#{status},</if>
            <if test="effectiveTime != null">#{effectiveTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark}</if>
        )
    </insert>

    <update id="updateDisclaimer" parameterType="com.ruoyi.outdoor.disclaimer.domain.Disclaimer">
        UPDATE dis_disclaimer
        <set>
            <if test="disclaimerTitle != null">disclaimer_title = #{disclaimerTitle},</if>
            <if test="disclaimerType != null">disclaimer_type = #{disclaimerType},</if>
            <if test="content != null">content = #{content},</if>
            <if test="version != null">version = #{version},</if>
            <if test="status != null">status = #{status},</if>
            <if test="effectiveTime != null">effective_time = #{effectiveTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE disclaimer_id = #{disclaimerId}
    </update>

    <delete id="deleteDisclaimerByDisclaimerId" parameterType="Long">
        DELETE FROM dis_disclaimer WHERE disclaimer_id = #{disclaimerId}
    </delete>
</mapper>
