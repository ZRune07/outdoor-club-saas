<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.outdoor.registration.mapper.RegistrationMapper">
    
    <resultMap type="Registration" id="RegistrationResult">
        <id     property="registrationId"   column="registration_id"   />
        <result property="clubId"           column="club_id"           />
        <result property="activityId"       column="activity_id"       />
        <result property="wxUserId"         column="wx_user_id"        />
        <result property="realName"         column="real_name"         />
        <result property="phone"            column="phone"             />
        <result property="idCard"           column="id_card"           />
        <result property="emergencyContact" column="emergency_contact" />
        <result property="emergencyPhone"   column="emergency_phone"   />
        <result property="status"           column="status"            />
        <result property="participantCount" column="participant_count" />
        <result property="message"          column="message"           />
        <result property="employeeId"       column="employee_id"       />
        <result property="extraFieldsJson"  column="extra_fields_json" />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
        <!-- 关联字段 -->
        <result property="activityTitle"      column="activity_title"      />
        <result property="activityStartTime"   column="activity_start_time" />
        <result property="activityLocation"   column="activity_location"   />
    </resultMap>

    <sql id="selectRegistrationVo">
        select r.registration_id, r.club_id, r.activity_id, r.wx_user_id, r.real_name, 
               r.phone, r.id_card, r.emergency_contact, r.emergency_phone, 
               r.status, r.participant_count, r.message, r.employee_id, r.extra_fields_json,
               r.create_by, r.create_time, r.update_by, r.update_time, r.remark,
               a.activity_title, a.start_time as activity_start_time, a.location as activity_location
        from reg_registration r
        left join act_activity a on r.activity_id = a.activity_id
    </sql>

    <select id="selectRegistrationList" parameterType="Registration" resultMap="RegistrationResult">
        <include refid="selectRegistrationVo"/>
        <where>  
            <if test="clubId != null"> and r.club_id = #{clubId}</if>
            <if test="activityId != null"> and r.activity_id = #{activityId}</if>
            <if test="wxUserId != null"> and r.wx_user_id = #{wxUserId}</if>
            <if test="realName != null and realName != ''"> and r.real_name like concat('%', #{realName}, '%')</if>
            <if test="phone != null and phone != ''"> and r.phone = #{phone}</if>
            <if test="status != null and status != ''"> and r.status = #{status}</if>
        </where>
        order by r.create_time desc
    </select>

    <select id="selectRegistrationByActivityId" parameterType="Long" resultMap="RegistrationResult">
        <include refid="selectRegistrationVo"/>
        where r.activity_id = #{activityId}
        order by r.create_time desc
    </select>
    
    <select id="selectRegistrationByWxUserId" parameterType="Long" resultMap="RegistrationResult">
        <include refid="selectRegistrationVo"/>
        where r.wx_user_id = #{wxUserId}
        order by r.create_time desc
    </select>

    <select id="selectRegistrationByRegistrationId" parameterType="Long" resultMap="RegistrationResult">
        <include refid="selectRegistrationVo"/>
        where r.registration_id = #{registrationId}
    </select>

    <select id="selectRegistrationByActivityAndUser" resultMap="RegistrationResult">
        <include refid="selectRegistrationVo"/>
        where r.activity_id = #{activityId} and r.wx_user_id = #{wxUserId}
        limit 1
    </select>

    <select id="countByActivityId" parameterType="Long" resultType="int">
        select count(*) from reg_registration
        where activity_id = #{activityId} and status != 'canceled'
    </select>

    <select id="selectMyRegistrations" resultMap="RegistrationResult">
        <include refid="selectRegistrationVo"/>
        where r.wx_user_id = #{wxUserId}
        <if test="clubId != null"> and r.club_id = #{clubId}</if>
        order by r.create_time desc
    </select>

    <select id="selectRegistrationStats" resultType="java.util.HashMap">
        select r.activity_id as "activityId", count(*) as "count"
        from reg_registration r
        where r.status not in ('cancelled', 'canceled', 'rejected')
        <if test="clubId != null"> and r.club_id = #{clubId}</if>
        <if test="activityIds != null and activityIds.length > 0">
            and r.activity_id in
            <foreach item="aid" collection="activityIds" open="(" separator="," close=")">
                #{aid}
            </foreach>
        </if>
        group by r.activity_id
    </select>

    <insert id="insertRegistration" parameterType="Registration" useGeneratedKeys="true" keyProperty="registrationId">
        insert into reg_registration
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="clubId != null">club_id,</if>
            <if test="activityId != null">activity_id,</if>
            <if test="wxUserId != null">wx_user_id,</if>
            <if test="realName != null and realName != ''">real_name,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="idCard != null">id_card,</if>
            <if test="emergencyContact != null">emergency_contact,</if>
            <if test="emergencyPhone != null">emergency_phone,</if>
            <if test="status != null">status,</if>
            <if test="participantCount != null">participant_count,</if>
            <if test="message != null">message,</if>
            <if test="employeeId != null">employee_id,</if>
            <if test="extraFieldsJson != null">extra_fields_json,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="clubId != null">#{clubId},</if>
            <if test="activityId != null">#{activityId},</if>
            <if test="wxUserId != null">#{wxUserId},</if>
            <if test="realName != null and realName != ''">#{realName},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="emergencyContact != null">#{emergencyContact},</if>
            <if test="emergencyPhone != null">#{emergencyPhone},</if>
            <if test="status != null">#{status},</if>
            <if test="participantCount != null">#{participantCount},</if>
            <if test="message != null">#{message},</if>
            <if test="employeeId != null">#{employeeId},</if>
            <if test="extraFieldsJson != null">#{extraFieldsJson},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateRegistration" parameterType="Registration">
        update reg_registration
        <trim prefix="SET" suffixOverrides=",">
            <if test="clubId != null">club_id = #{clubId},</if>
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="wxUserId != null">wx_user_id = #{wxUserId},</if>
            <if test="realName != null and realName != ''">real_name = #{realName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="emergencyContact != null">emergency_contact = #{emergencyContact},</if>
            <if test="emergencyPhone != null">emergency_phone = #{emergencyPhone},</if>
            <if test="status != null">status = #{status},</if>
            <if test="participantCount != null">participant_count = #{participantCount},</if>
            <if test="message != null">message = #{message},</if>
            <if test="employeeId != null">employee_id = #{employeeId},</if>
            <if test="extraFieldsJson != null">extra_fields_json = #{extraFieldsJson},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where registration_id = #{registrationId}
    </update>

    <update id="updateRegistrationStatus">
        update reg_registration set status = #{status}, update_time = now()
        where registration_id = #{registrationId}
    </update>

    <delete id="deleteRegistrationByRegistrationId" parameterType="Long">
        delete from reg_registration where registration_id = #{registrationId}
    </delete>

    <delete id="deleteRegistrationByRegistrationIds" parameterType="Long">
        delete from reg_registration where registration_id in 
        <foreach item="registrationId" collection="array" open="(" separator="," close=")">
            #{registrationId}
        </foreach>
    </delete>
</mapper>
