<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.outdoor.registration.mapper.RegistrationMapper">
    
    <resultMap type="Registration" id="RegistrationResult">
        <id     property="registrationId"   column="registration_id"   />
        <result property="clubId"           column="club_id"           />
        <result property="activityId"       column="activity_id"       />
        <result property="wxUserId"         column="wx_user_id"        />
        <result property="realName"         column="real_name"         />
        <result property="phone"            column="phone"             />
        <result property="idCard"           column="id_card"           />
        <result property="emergencyContact" column="emergency_contact" />
        <result property="emergencyPhone"   column="emergency_phone"   />
        <result property="participantCount" column="participant_count" />
        <result property="totalFee"         column="total_fee"         />
        <result property="status"           column="status"            />
        <result property="delFlag"          column="del_flag"          />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
    </resultMap>

    <sql id="selectRegistrationVo">
        select registration_id, club_id, activity_id, wx_user_id, real_name, phone, id_card, emergency_contact, emergency_phone, participant_count, total_fee, status, del_flag, create_by, create_time, update_by, update_time, remark from outdoor_registration
    </sql>

    <select id="selectRegistrationList" parameterType="Registration" resultMap="RegistrationResult">
        <include refid="selectRegistrationVo"/>
        <where>  
            del_flag = '0'
            <if test="clubId != null "> and club_id = #{clubId}</if>
            <if test="activityId != null "> and activity_id = #{activityId}</if>
            <if test="wxUserId != null "> and wx_user_id = #{wxUserId}</if>
            <if test="realName != null  and realName != ''"> and real_name like concat('%', #{realName}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectRegistrationByRegistrationId" parameterType="Long" resultMap="RegistrationResult">
        <include refid="selectRegistrationVo"/>
        where registration_id = #{registrationId}
    </select>
        
    <insert id="insertRegistration" parameterType="Registration" useGeneratedKeys="true" keyProperty="registrationId">
        insert into outdoor_registration
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="clubId != null">club_id,</if>
            <if test="activityId != null">activity_id,</if>
            <if test="wxUserId != null">wx_user_id,</if>
            <if test="realName != null and realName != ''">real_name,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="idCard != null">id_card,</if>
            <if test="emergencyContact != null">emergency_contact,</if>
            <if test="emergencyPhone != null">emergency_phone,</if>
            <if test="participantCount != null">participant_count,</if>
            <if test="totalFee != null">total_fee,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="clubId != null">#{clubId},</if>
            <if test="activityId != null">#{activityId},</if>
            <if test="wxUserId != null">#{wxUserId},</if>
            <if test="realName != null and realName != ''">#{realName},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="emergencyContact != null">#{emergencyContact},</if>
            <if test="emergencyPhone != null">#{emergencyPhone},</if>
            <if test="participantCount != null">#{participantCount},</if>
            <if test="totalFee != null">#{totalFee},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateRegistration" parameterType="Registration">
        update outdoor_registration
        <trim prefix="SET" suffixOverrides=",">
            <if test="clubId != null">club_id = #{clubId},</if>
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="wxUserId != null">wx_user_id = #{wxUserId},</if>
            <if test="realName != null and realName != ''">real_name = #{realName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="emergencyContact != null">emergency_contact = #{emergencyContact},</if>
            <if test="emergencyPhone != null">emergency_phone = #{emergencyPhone},</if>
            <if test="participantCount != null">participant_count = #{participantCount},</if>
            <if test="totalFee != null">total_fee = #{totalFee},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where registration_id = #{registrationId}
    </update>

    <update id="deleteRegistrationByRegistrationId" parameterType="Long">
        update outdoor_registration set del_flag = '2' where registration_id = #{registrationId}
    </update>

    <update id="deleteRegistrationByRegistrationIds" parameterType="Long">
        update outdoor_registration set del_flag = '2' where registration_id in 
        <foreach item="registrationId" collection="array" open="(" separator="," close=")">
            #{registrationId}
        </foreach>
    </update>
</mapper>
