# Coze Code 项目配置文件
# 户外俱乐部SaaS - 纯前端 (Vue3 + Element Plus)

[project]
# 项目入口配置
entrypoint = "ruoyi-ui/index.html"
requires = ["nodejs-18"]
description = "户外俱乐部SaaS管理平台 - 前端"

[dev]
# 开发环境构建命令
build = [
  "bash .cozeproj/scripts/dev_build.sh"
]
# 开发环境运行命令
run = [
  "bash .cozeproj/scripts/dev_run.sh"
]

[ports]
# 端口映射
# 前端管理端: 80

[env]
# 环境变量
NODE_ENV = "production"
