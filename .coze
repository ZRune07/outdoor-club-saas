# Coze Code 项目配置文件
# 户外俱乐部SaaS - Spring Boot + Vue3

[project]
# 项目入口配置
entrypoint = "ruoyi-admin/src/main/java/com/ruoyi/RuoYiApplication.java"
requires = ["nodejs-18", "java-17"]
description = "户外俱乐部SaaS管理平台"

[dev]
# 开发环境构建命令
build = [
  "bash .cozeproj/scripts/dev_build.sh"
]
# 开发环境运行命令
run = [
  "bash .cozeproj/scripts/dev_run.sh"
]

[ports]
# 端口映射
# 后端API: 9091
# 前端管理端: 5000
# H5前端: 3000

[env]
# 环境变量
NODE_ENV = "development"
SPRING_PROFILES_ACTIVE = "dev"
