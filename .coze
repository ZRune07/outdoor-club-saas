[project]
entrypoint = "ruoyi-ui/dist/index.html"
description = "户外俱乐部SaaS管理平台"

[dev]
build = ["cd ruoyi-ui && npm install && npm run build:prod"]
run = ["npx", "serve", "ruoyi-ui/dist", "-l", "5000"]

[deploy]
build = ["cd ruoyi-ui && npm install && npm run build:prod"]
run = ["npx", "serve", "ruoyi-ui/dist", "-l", "5000"]
