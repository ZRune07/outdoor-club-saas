<!--pages/contact/contact.wxml-->
<view class="page-contact">
  <!-- 头部提示 -->
  <view class="header-tip">
    <text class="tip-icon">💡</text>
    <text class="tip-text">填写您的需求，专属顾问将为您量身定制方案</text>
  </view>

  <!-- 表单区域 -->
  <view class="form-section card">
    <!-- 关联产品 -->
    <view class="form-item" wx:if="{{form.product}}">
      <text class="form-label">咨询产品</text>
      <view class="form-value product-tag">{{form.product}}</view>
    </view>

    <!-- 姓名 -->
    <view class="form-item">
      <text class="form-label required">您的姓名</text>
      <input class="form-input" 
             placeholder="请输入您的姓名" 
             value="{{form.name}}"
             bindinput="onInput"
             data-field="name"/>
    </view>

    <!-- 电话 -->
    <view class="form-item">
      <text class="form-label required">联系电话</text>
      <input class="form-input" 
             type="number"
             maxlength="11"
             placeholder="请输入您的手机号" 
             value="{{form.phone}}"
             bindinput="onInput"
             data-field="phone"/>
    </view>

    <!-- 公司 -->
    <view class="form-item">
      <text class="form-label">公司名称</text>
      <input class="form-input" 
             placeholder="请输入公司名称（选填）" 
             value="{{form.company}}"
             bindinput="onInput"
             data-field="company"/>
    </view>

    <!-- 人数 -->
    <view class="form-item">
      <text class="form-label">预计人数</text>
      <picker mode="selector" 
              range="{{peopleOptions}}" 
              value="{{peopleIndex}}"
              bindchange="onPeopleChange">
        <view class="form-picker">
          <text class="picker-text {{peopleIndex >= 0 ? '' : 'placeholder'}}">
            {{peopleIndex >= 0 ? peopleOptions[peopleIndex] : '请选择预计人数'}}
          </text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 预算 -->
    <view class="form-item">
      <text class="form-label">预算范围</text>
      <picker mode="selector" 
              range="{{budgetOptions}}" 
              value="{{budgetIndex}}"
              bindchange="onBudgetChange">
        <view class="form-picker">
          <text class="picker-text {{budgetIndex >= 0 ? '' : 'placeholder'}}">
            {{budgetIndex >= 0 ? budgetOptions[budgetIndex] : '请选择预算范围'}}
          </text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 需求描述 -->
    <view class="form-item">
      <text class="form-label required">需求描述</text>
      <textarea class="form-textarea" 
                placeholder="请描述您的团建需求，如时间、地点、活动类型等" 
                value="{{form.requirement}}"
                bindinput="onInput"
                data-field="requirement"
                maxlength="500"/>
      <text class="textarea-count">{{form.requirement.length}}/500</text>
    </view>
  </view>

  <!-- 快捷联系 -->
  <view class="quick-contact" bindtap="callPhone">
    <text class="quick-icon">📞</text>
    <text class="quick-text">或直接拨打：{{phone || '18653188848'}}</text>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="btn-submit {{submitting ? 'disabled' : ''}}" 
            bindtap="submitForm"
            disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交需求'}}
    </button>
  </view>
</view>
