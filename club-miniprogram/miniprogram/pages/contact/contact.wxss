/* pages/contact/contact.wxss */

.page-contact {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 140rpx;
}

/* 头部提示 */
.header-tip {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #FFF5EE, #FFE5D5);
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: var(--primary-color);
}

/* 表单区域 */
.form-section {
  margin: 20rpx 30rpx;
  padding: 10rpx 30rpx;
}

.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 16rpx 0;
}

.form-input::placeholder {
  color: var(--text-light);
}

.form-value {
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 16rpx 0;
}

.product-tag {
  display: inline-block;
  background: linear-gradient(135deg, #FFF5EE, #FFE5D5);
  color: var(--primary-color);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

/* 选择器样式 */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.picker-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.picker-text.placeholder {
  color: var(--text-light);
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--text-light);
  transform: rotate(90deg);
}

/* 文本域 */
.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 16rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: var(--text-light);
}

.textarea-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

/* 快捷联系 */
.quick-contact {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.quick-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.quick-text {
  font-size: 28rpx;
  color: var(--primary-color);
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: var(--white);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}

.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  color: var(--white);
  border: none;
  border-radius: 50rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-submit::after {
  border: none;
}

.btn-submit.disabled {
  opacity: 0.6;
}
