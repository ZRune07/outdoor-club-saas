/* pages/detail/detail.wxss */

.page-detail {
  padding-bottom: 140rpx;
  background: var(--detail-bg-color, var(--bg-color));
  min-height: 100vh;
}

/* 头图 */
.detail-header {
  width: 100%;
  height: 420rpx;
}

.header-image {
  width: 100%;
  height: 100%;
}

/* 标题信息 */
.detail-info {
  margin: -40rpx 30rpx 20rpx;
  padding: 40rpx 30rpx;
  position: relative;
  z-index: 10;
  background: var(--detail-card-bg, var(--white));
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--detail-text-primary, var(--text-primary));
  line-height: 1.5;
  display: block;
  margin-bottom: 16rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: var(--detail-primary-color, var(--primary-color));
  background: var(--detail-tag-bg, rgba(255, 107, 0, 0.1));
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.meta-date {
  font-size: 24rpx;
  color: var(--detail-text-light, var(--text-light));
}

/* 内容区域 */
.detail-content {
  margin: 0 30rpx 20rpx;
  padding: 40rpx 30rpx;
  background: var(--detail-card-bg, var(--white));
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}

.detail-content rich-text {
  font-size: 30rpx;
  color: var(--detail-text-primary, var(--text-primary));
  line-height: 1.8;
}

.detail-content .rich-content {
  color: #333333;
  font-size: 30rpx;
  line-height: 1.8;
  word-break: break-word;
}

.detail-content .rich-content p {
  margin: 0 0 30rpx;
  text-align: justify;
  letter-spacing: 1rpx;
}

.detail-content .rich-content img {
  width: 100%;
  max-width: 100%;
  height: auto;
  display: block;
  margin: 30rpx auto;
  border-radius: 16rpx;
}

.detail-content .rich-content h1 {
  font-size: 44rpx;
  font-weight: 600;
  margin: 40rpx 0 24rpx;
  color: #1a1a1a;
  line-height: 1.4;
}

.detail-content .rich-content h2 {
  font-size: 36rpx;
  font-weight: 600;
  margin: 40rpx 0 20rpx;
  color: #1a1a1a;
  line-height: 1.4;
}

.detail-content .rich-content h3 {
  font-size: 32rpx;
  font-weight: 600;
  margin: 32rpx 0 16rpx;
  color: #1a1a1a;
  line-height: 1.4;
}

.detail-content .rich-content h4 {
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 0 14rpx;
  color: #1a1a1a;
}

.detail-content .rich-content h5,
.detail-content .rich-content h6 {
  font-size: 28rpx;
  font-weight: 600;
  margin: 12rpx 0 12rpx;
}

.detail-content .rich-content strong,
.detail-content .rich-content b {
  font-weight: 600;
}

.detail-content .rich-content em,
.detail-content .rich-content i {
  font-style: italic;
}

.detail-content .rich-content a {
  color: var(--detail-primary-color, var(--primary-color));
  text-decoration: underline;
  text-decoration-color: rgba(255, 107, 0, 0.3);
  text-underline-offset: 4rpx;
}

.detail-content .rich-content ul,
.detail-content .rich-content ol {
  margin: 0 0 24rpx;
  padding-left: 36rpx;
}

.detail-content .rich-content li {
  margin-bottom: 12rpx;
}

.detail-content .rich-content blockquote {
  margin: 30rpx 0;
  padding: 24rpx 30rpx;
  background: #f8f9fa;
  border-left: 8rpx solid var(--detail-primary-color, var(--primary-color));
  border-radius: 0 12rpx 12rpx 0;
  color: #666666;
  font-size: 28rpx;
}

.detail-content .rich-content hr {
  border: 0;
  border-top: 2rpx dashed var(--detail-border-color, #E5E5E5);
  margin: 40rpx 0;
}

.detail-content .rich-content table {
  width: 100%;
  border-collapse: collapse;
  margin: 30rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.detail-content .rich-content th {
  background: #f8f9fa;
  font-weight: 600;
  color: #333;
  padding: 16rpx;
  border: 1rpx solid #eeeeee;
  font-size: 28rpx;
}

.detail-content .rich-content td {
  border: 1rpx solid #eeeeee;
  padding: 16rpx;
  font-size: 28rpx;
  color: #666;
}

.detail-content .rich-content tr:nth-child(even) {
  background: #fafafa;
}

/* 代码块样式 */
.detail-content .rich-content pre {
  background: #f5f6f8;
  padding: 24rpx;
  border-radius: 12rpx;
  overflow-x: auto;
  margin: 30rpx 0;
  font-family: monospace;
  font-size: 26rpx;
  color: #333;
}

.detail-content .rich-content code {
  background: #f5f6f8;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  color: #e83e8c;
  font-family: monospace;
  font-size: 26rpx;
}

.detail-content .rich-content [data-align="right"] {
  text-align: right;
}

.detail-content .rich-content [data-align="justify"] {
  text-align: justify;
}

/* 版权信息样式 */
.copyright-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 30rpx 10rpx;
  padding: 30rpx 0;
}

.copyright-line {
  flex: 1;
  height: 1rpx;
  background: var(--detail-border-color, var(--border-color));
  margin: 0 20rpx;
}

.copyright-text {
  font-size: 28rpx;
  color: var(--detail-text-secondary, var(--text-secondary));
  font-weight: 500;
}

/* Bottom Navigation */
.bottom-nav-placeholder {
  height: 120rpx; /* Height of nav + buffer */
  width: 100%;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 110rpx;
  background: var(--detail-bottom-nav-bg, #FFFFFF);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  box-sizing: border-box;
}

/* 首页按钮样式 */
.nav-home {
  display: flex;
  flex-direction: row; /* Horizontal layout */
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  padding: 0 20rpx; /* Increase hit area */
}

.nav-home-emoji {
  font-size: 70rpx; /* Increased by 10% from 64rpx */
  line-height: 1;
  margin-right: 8rpx; /* Add right margin */
}

.nav-home-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 8rpx;
}

.nav-home-text {
  font-size: 30rpx; /* Match right button text size */
  color: var(--detail-text-secondary, var(--text-secondary));
  font-weight: 500;
}

.nav-buttons {
  flex: 1;
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  height: 88rpx;
}

.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  border-radius: 12rpx;
  color: #FFFFFF;
  border: none;
}

.btn-call-green {
  background: #00C853;
}

.emoji-icon {
  margin-right: 10rpx;
  font-size: 34rpx;
}



/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--detail-border-color, var(--border-color));
  border-top-color: var(--detail-primary-color, var(--primary-color));
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  color: var(--detail-text-light, var(--text-light));
  font-size: 28rpx;
}

/* 视频样式 */
.video-section {
  margin-bottom: 30rpx;
}

.detail-video {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

/* 外部视频按钮 */
.external-video-section {
  margin-bottom: 30rpx;
}

.external-video-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: var(--detail-external-btn-bg, #F8F9FA);
  border-radius: 12rpx;
  border: 1rpx solid var(--detail-external-btn-border, #EEEEEE);
  margin-bottom: 20rpx;
}

.external-video-btn:active {
  background: var(--detail-external-btn-active-bg, #F0F0F0);
}

.video-icon {
  font-size: 34rpx;
  margin-right: 16rpx;
}

.video-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--detail-text-primary, var(--text-primary));
  font-weight: 500;
}

.arrow-icon {
  font-size: 26rpx;
  color: var(--detail-text-light, var(--text-light));
}

/* 报名按钮样式 */
.btn-enroll-orange {
  background: #FF6B00;
  margin-left: 12rpx;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease-in-out;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 24rpx;
  width: 92%;
  max-width: 700rpx;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  animation: slideUp 0.3s ease-in-out;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(50rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
  line-height: 1;
  padding: 8rpx;
}

.modal-body {
  padding: 32rpx;
}

/* 表单样式 */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12rpx;
}

.required-mark {
  color: #FF4D4F;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  padding: 32rpx 28rpx;
  border: 1rpx solid #EEEEEE;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  line-height: 1.6;
  min-height: 88rpx;
}

.form-textarea {
  width: 100%;
  padding: 32rpx 28rpx;
  border: 1rpx solid #EEEEEE;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  min-height: 180rpx;
  resize: none;
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
  padding: 24rpx;
  background: #FF6B00;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.submit-btn::after {
  border: none;
}

/* 电子协议弹窗样式 */
.agreement-modal {
  width: 90%;
  max-height: 85vh;
}

.agreement-content {
  max-height: 400rpx;
  overflow-y: auto;
  margin-bottom: 32rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.agreement-content rich-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #333333;
}

/* 签名区域样式 */
.signature-section {
  margin-bottom: 32rpx;
}

.signature-canvas {
  position: relative;
  border: 1rpx solid #EEEEEE;
  border-radius: 12rpx;
  background: #fafafa;
}

.signature-area {
  width: 100%;
  height: 200rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
}

.clear-signature {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  background: #F0F0F0;
  color: #666666;
  border: none;
  border-radius: 8rpx;
}

.clear-signature::after {
  border: none;
}

