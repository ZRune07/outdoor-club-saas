/* pages/about/about.wxss */

.page-about-wrapper {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding-top: 88rpx; /* 状态栏高度 */
  padding-left: 20rpx;
  padding-bottom: 20rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.back-icon {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
}

.page-about {
  flex: 1;
  padding-bottom: 140rpx;
  background: var(--bg-color);
}

/* 顶部特色图片 */
.header-section {
  width: 100%;
  height: 420rpx;
  position: relative;
}

.header-image {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

/* 标题信息 */
.detail-info {
  margin: -40rpx 30rpx 20rpx;
  padding: 40rpx 30rpx;
  position: relative;
  z-index: 10;
  background: var(--detail-card-bg, var(--white, #fff));
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--detail-text-primary, var(--text-primary, #333));
  line-height: 1.5;
  display: block;
  margin-bottom: 16rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: var(--detail-primary-color, var(--primary-color, #ff6b00));
  background: var(--detail-tag-bg, rgba(255, 107, 0, 0.1));
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.meta-date {
  font-size: 24rpx;
  color: var(--detail-text-light, var(--text-light, #999));
}

/* 内容区域 */
.content-section {
  margin: 0 30rpx 20rpx;
  padding: 40rpx 30rpx;
  background: var(--detail-card-bg, var(--white, #fff));
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}

.content-section .rich-content {
  color: #333333;
  font-size: 30rpx;
  line-height: 1.8;
  word-break: break-word;
}

.content-section .rich-content p {
  margin: 0 0 30rpx;
  text-align: justify;
  letter-spacing: 1rpx;
}

.content-section .rich-content img {
  width: 100%;
  max-width: 100%;
  height: auto;
  display: block;
  margin: 30rpx auto;
  border-radius: 16rpx;
}

.content-section .rich-content h1 {
  font-size: 44rpx;
  font-weight: 600;
  margin: 40rpx 0 24rpx;
  color: #1a1a1a;
  line-height: 1.4;
}

.content-section .rich-content h2 {
  font-size: 36rpx;
  font-weight: 600;
  margin: 40rpx 0 20rpx;
  color: #1a1a1a;
  line-height: 1.4;
}

.content-section .rich-content h3 {
  font-size: 32rpx;
  font-weight: 600;
  margin: 32rpx 0 16rpx;
  color: #1a1a1a;
  line-height: 1.4;
}

.content-section .rich-content h4 {
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 0 14rpx;
  color: #1a1a1a;
}

.content-section .rich-content h5,
.content-section .rich-content h6 {
  font-size: 28rpx;
  font-weight: 600;
  margin: 12rpx 0 12rpx;
}

.content-section .rich-content strong,
.content-section .rich-content b {
  font-weight: 600;
}

.content-section .rich-content em,
.content-section .rich-content i {
  font-style: italic;
}

.content-section .rich-content a {
  color: var(--detail-primary-color, var(--primary-color, #ff6b00));
  text-decoration: underline;
  text-decoration-color: rgba(255, 107, 0, 0.3);
  text-underline-offset: 4rpx;
}

.content-section .rich-content ul,
.content-section .rich-content ol {
  margin: 0 0 24rpx;
  padding-left: 36rpx;
}

.content-section .rich-content li {
  margin-bottom: 12rpx;
}

.content-section .rich-content blockquote {
  margin: 30rpx 0;
  padding: 24rpx 30rpx;
  background: #f8f9fa;
  border-left: 8rpx solid var(--detail-primary-color, var(--primary-color, #ff6b00));
  border-radius: 0 12rpx 12rpx 0;
  color: #666666;
  font-size: 28rpx;
}

.content-section .rich-content hr {
  border: 0;
  border-top: 2rpx dashed var(--detail-border-color, var(--border-color, #E5E5E5));
  margin: 40rpx 0;
}

/* 视频样式 */
.video-section {
  margin-bottom: 30rpx;
}

.wp-video {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* 品牌头部 */
.brand-section {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.brand-bg {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.brand-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,107,0,0.9), rgba(255,140,51,0.85));
  z-index: 1;
}

.brand-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 40rpx;
}

.brand-logo {
  width: 160rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.brand-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 12rpx;
}

.brand-slogan {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
}

/* 通用卡片样式 */
.card {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: var(--white);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  position: relative;
  padding-left: 24rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: var(--primary-color);
  border-radius: 4rpx;
}

/* 公司介绍 */
.intro-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* 核心优势 */
.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 服务内容 */
.services-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.service-item {
  display: flex;
  align-items: flex-start;
}

.service-dot {
  color: var(--primary-color);
  font-size: 20rpx;
  margin-right: 12rpx;
  margin-top: 8rpx;
}

.service-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 服务区域 */
.areas-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.area-tag {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #FFF5EE, #FFE5D5);
  color: var(--primary-color);
  font-size: 26rpx;
  border-radius: 30rpx;
}

/* 联系方式 */
.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 24rpx;
  color: var(--text-light);
  display: block;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.contact-action {
  font-size: 26rpx;
  color: var(--primary-color);
}


/* 底部导航条样式 */
.bottom-nav-placeholder {
  height: 120rpx;
  width: 100%;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 110rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  box-sizing: border-box;
}

.nav-consultant {
  display: flex;
  align-items: center;
}

.nav-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 2rpx solid #eee;
}

.nav-consultant-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nav-consultant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}

.nav-consultant-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.nav-buttons {
  flex: 1;
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  height: 88rpx;
}

.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  border-radius: 12rpx;
  color: #FFFFFF;
  border: none;
}

.nav-btn::after {
  border: none;
}

.btn-call-green {
  background: #00C853;
}

.emoji-icon {
  margin-right: 10rpx;
  font-size: 34rpx;
}

/* 外部视频按钮 */
.external-video-section {
  margin-bottom: 30rpx;
}

.external-video-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

.external-video-btn:active {
  background: #f0f0f0;
}

.video-icon {
  font-size: 34rpx;
  margin-right: 16rpx;
}

.video-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.arrow-icon {
  font-size: 26rpx;
  color: #999;
}

/* 版权信息 */
.copyright-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 30rpx 10rpx;
  padding: 30rpx 0;
}

.copyright-line {
  flex: 1;
  height: 1rpx;
  background: var(--detail-border-color, var(--border-color, #E5E5E5));
  margin: 0 20rpx;
}

.copyright-text {
  font-size: 28rpx;
  color: var(--detail-text-secondary, var(--text-secondary, #666));
  font-weight: 500;
  text-align: center;
}
