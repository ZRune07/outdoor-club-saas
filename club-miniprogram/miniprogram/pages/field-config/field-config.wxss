/* pages/field-config/field-config.wxss */
.field-config-page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #142033;
  padding-bottom: 48rpx;
}

.top-band {
  padding: 44rpx 28rpx 82rpx;
  background: linear-gradient(135deg, #102033 0%, #0f766e 100%);
  color: #ffffff;
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.74);
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.84);
}

.tenant-pill {
  margin-top: 28rpx;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.12);
}

.tenant-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.tenant-value {
  font-size: 24rpx;
  font-weight: 700;
}

.content {
  margin-top: -52rpx;
  padding: 0 24rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.metric-card,
.panel {
  background: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.07);
}

.metric-card {
  min-height: 150rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.metric-value {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #101828;
}

.text-value {
  font-size: 28rpx;
  line-height: 1.35;
}

.metric-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.35;
  color: #64748b;
}

.panel {
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-title,
.field-title,
.modal-title {
  display: block;
  font-weight: 800;
  color: #101828;
}

.panel-title {
  font-size: 32rpx;
}

.panel-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #64748b;
}

.primary-btn,
.secondary-btn,
.small-btn,
.danger-btn,
.primary-btn::after,
.secondary-btn::after,
.small-btn::after,
.danger-btn::after {
  border: none;
}

.primary-btn,
.secondary-btn,
.small-btn,
.danger-btn {
  margin: 0;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.primary-btn {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 24rpx;
  background: #0f766e;
  color: #ffffff;
  font-weight: 700;
}

.secondary-btn,
.small-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  background: #eef6ff;
  color: #1d4ed8;
}

.danger-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  background: #fff1f2;
  color: #dc2626;
}

.field-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.field-item {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f8fafc;
}

.field-main {
  flex: 1;
  min-width: 0;
}

.field-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.field-title {
  font-size: 29rpx;
}

.field-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #64748b;
  word-break: break-all;
}

.required-tag {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 20rpx;
  font-weight: 700;
}

.field-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.preview-box,
.empty-inline {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  font-size: 25rpx;
  line-height: 1.7;
  color: #334155;
}

.form-line {
  margin-top: 24rpx;
}

.switch-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #101828;
}

.form-input,
.form-textarea,
.picker-input,
.agreement-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 8rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  color: #101828;
  font-size: 26rpx;
}

.form-input,
.picker-input {
  min-height: 82rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
}

.form-textarea {
  min-height: 180rpx;
  padding: 20rpx;
  line-height: 1.65;
}

.agreement-textarea {
  min-height: 520rpx;
  padding: 20rpx;
  line-height: 1.7;
}

.form-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #64748b;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: rgba(15, 23, 42, 0.52);
}

.modal-content {
  width: 100%;
  max-width: 700rpx;
  max-height: 88vh;
  overflow-y: auto;
  border-radius: 8rpx;
  background: #ffffff;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #e8eef5;
}

.modal-title {
  font-size: 34rpx;
}

.modal-close {
  font-size: 42rpx;
  color: #94a3b8;
}

.modal-body {
  padding: 26rpx 28rpx 30rpx;
}

.modal-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.flex-btn {
  flex: 1;
}

.check-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #334155;
}

.checkbox {
  width: 42rpx;
  height: 42rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: #0f766e;
  border-color: #0f766e;
  color: #ffffff;
}
