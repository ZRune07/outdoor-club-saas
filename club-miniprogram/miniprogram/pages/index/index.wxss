/* pages/index/index.wxss */

.page-index {
  padding-bottom: 30rpx;
}

/* 顶部背景容器 */
.header-bg-wrapper {
  position: relative;
  width: 100%;
  height: 545rpx; /* 增加高度，使背景图延伸到轮播图底部 */
}

.header-bg-wrapper-function {
  height: 400rpx;
}

/* 背景图片 */
.header-bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%; /* Match wrapper */
  z-index: 0;
}

/* 默认渐变背景 */
.header-bg-default {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%; /* Match wrapper */
  background: var(--bg-color);
  z-index: 0;
}

/* 顶部区域 */
.header {
  position: relative;
  display: flex;
  align-items: center;
  padding: 10rpx 30rpx;
  z-index: 1;
}

.header-logo-container {
  position: absolute;
  z-index: 999;
  display: flex;
  align-items: center;
}

.header-logo {
  height: 100%;
  width: 338rpx; /* 260rpx * 1.3，放大30% */
}




/* 轮播图区域 */
.banner-section {
  position: relative;
  width: 100%;
  padding: 0 30rpx;
  margin-top: -345rpx; /* 轮播图上移，覆盖在背景图上 */
  box-sizing: border-box;
  z-index: 1;
}

.banner-swiper {
  height: 345rpx; /* 16:8 ratio (2:1) -> 690 * 0.5 = 345rpx */
  border-radius: 24rpx;
  overflow: hidden;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
}

.banner-section-function {
  margin-top: -172rpx;
}

.banner-swiper-function {
  height: 172rpx;
}

/* 自定义轮播图指示点 */
.banner-swiper .wx-swiper-dot {
  width: 12rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  transition: all 0.3s;
}

.banner-swiper .wx-swiper-dot-active {
  width: 36rpx;
  height: 12rpx;
  background: #ffffff;
  border-radius: 6rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 倒影和分类入口容器 */
.content-with-reflection {
  position: relative;
  padding: 0 30rpx;
  z-index: 2;
}

.banner-default {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.brand-logo {
  width: 300rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
}

.brand-slogan {
  color: var(--white);
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.brand-desc {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
}

/* 分类区域 */
.category-section {
  position: relative;
  margin: 20rpx 30rpx;
  padding: 30rpx 20rpx;
  z-index: 1;
  background: transparent !important;
  box-shadow: none !important;
}

.category-grid {
  display: flex;
  justify-content: space-around;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  background: none;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  transition: transform 0.2s;
  box-shadow: none;
}

.category-icon-wrap:active {
  transform: scale(0.95);
}

.category-icon {
  width: 74rpx;
  height: 74rpx;
}

.category-name {
  font-size: 26rpx;
  color: var(--text-primary);
}

/* 服务卡片区域 */
.service-section {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
  margin-top: 50rpx; /* Add space for the popped-out icons */
}

.service-card {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start; /* Left align everything */
  overflow: visible !important; /* Allow icon to pop out */
}

/* Service Header: Icon + Title */
.service-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  width: 100%;
}

.service-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  margin-bottom: 0;
  margin-top: -50rpx; /* Pop out by half (approx) + extra */
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.service-icon-wrap.consultant {
  background: linear-gradient(135deg, #FFE5CC, #FFD4B3);
  overflow: hidden;
  padding: 0;
}

.service-icon-wrap.consultant .service-icon {
  width: 100%;
  height: 100%;
}

.service-icon-wrap.custom {
  background: linear-gradient(135deg, #E5F0FF, #CCE0FF);
  overflow: hidden;
  padding: 0;
}

.service-icon-wrap.custom .service-icon {
  width: 100%;
  height: 100%;
}

.service-icon {
  width: 44rpx;
  height: 44rpx;
}

.service-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0; /* Remove bottom margin */
  flex: 1;
}

.service-desc {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.5;
  margin-bottom: 16rpx;
  text-align: left;
}

.service-action {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 热门方案区域 */
.hot-plans-section {
  margin-top: 40rpx;
  margin-bottom: 30rpx;
}

/* 热门目的地区域 */
.hot-destinations-section {
  margin-bottom: 30rpx;
}

/* 滚动区域包装器 */
.scroll-wrapper {
  position: relative;
  width: 100%;
}

/* 左侧遮罩 */
.scroll-mask-left {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 30rpx;
  background: #f5f5f5;
  z-index: 10;
  pointer-events: none;
}

/* 右侧遮罩 */
.scroll-mask-right {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 30rpx;
  background: #f5f5f5;
  z-index: 10;
  pointer-events: none;
}
/* 通用横向滚动容器 */
.section-scroll-container {
  width: 100%;
  white-space: nowrap;
  padding-left: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
}

/* 两排网格布局 (Flex Column Wrap with fixed height) */
.grid-2-rows {
  display: inline-flex;
  flex-direction: column;
  flex-wrap: wrap;
  height: 460rpx;
  align-content: flex-start;
  padding-right: 30rpx;
}

/* 横版2x2网格 (For Hot Plans) */
.grid-2-rows-vertical {
  display: inline-flex;
  flex-direction: column;
  flex-wrap: wrap;
  height: 440rpx; /* 两张卡片高度 200*2 + 间距 40 */
  align-content: flex-start;
  padding-right: 30rpx;
}

/* 热门方案占位卡片 */
.plan-card-spacer {
  width: 30rpx;
  height: 200rpx; /* 与 plan-card 高度一致 */
  flex-shrink: 0;
}

/* 热门目的地占位卡片 - 与 destination-card 尺寸相同 */
.destination-card-spacer {
  width: 30rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

/* 热门专题占位卡片 */
.topic-card-spacer {
  width: 30rpx;
  flex-shrink: 0;
}

/* 方案卡片 & 目的地卡片 通用样式 */
.destination-card {
  width: 320rpx;
  height: 200rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  display: inline-block; /* Fallback */
  flex-shrink: 0;
}

/* Plan Card (2x2布局 16:9) */
.plan-card {
  width: 330rpx; /* 一页显示两个: (750-60-20)/2 ≈ 335 */
  height: 200rpx; /* 纯图片模式 */
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
  display: inline-block;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.plan-image-wrap {
  width: 100%;
  height: 100%; /* 图片填满卡片 */
  position: relative;
}

.plan-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx 16rpx 0 0;
}

.plan-info {
  display: none; /* 隐藏标题，只显示图片 */
}

.plan-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  white-space: normal; /* 覆盖父级的 nowrap，允许换行 */
}

.plan-meta {
  display: none; /* 隐藏空的 meta 区域 */
}

.plan-author {
  font-size: 22rpx;
  color: #999;
}

.destination-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.plan-name, .destination-name {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  color: white;
  padding: 12rpx;
  font-size: 26rpx;
  text-align: center;
  white-space: normal; /* Allow text wrap */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 公共标题样式 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 30rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-scroll-hint {
  font-size: 24rpx;
  color: #999;
}

.section-action {
  font-size: 24rpx;
  color: var(--primary-color);
}

.section-hint {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}



/* 热门专题区域 */
.hot-topics-section {
  margin-bottom: 40rpx;
}

.topic-scroll-container {
  width: 100%;
  white-space: nowrap;
  padding-left: 30rpx;
  box-sizing: border-box;
}

.topic-list {
  display: inline-flex;
  padding-right: 30rpx;
}

/* Bottom Navigation */
.bottom-nav-placeholder {
  height: calc(170rpx + env(safe-area-inset-bottom));
  width: 100%;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 28rpx rgba(15, 23, 42, 0.08);
  z-index: 100;
  box-sizing: border-box;
}

.bottom-tabbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 100rpx;
  border-radius: 22rpx;
}

.tabbar-item-active {
  background: rgba(255, 107, 0, 0.08);
}

.tabbar-icon {
  width: 42rpx;
  height: 42rpx;
}

.tabbar-label {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1;
}

.tabbar-item-active .tabbar-label {
  color: #FF6B00;
  font-weight: 600;
}

.floating-consultant {
  position: fixed;
  left: 24rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 124rpx;
  padding: 18rpx 14rpx 16rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.14);
  z-index: 120;
  box-sizing: border-box;
}

.floating-consultant-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid #ffffff;
}

.floating-consultant-info {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.floating-consultant-name {
  max-width: 96rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.floating-consultant-call-icon {
  width: 66rpx;
  height: 66rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
}

.topic-card {
  width: 330rpx; /* 一页显示两个: (750-60-20)/2 ≈ 335 */
  margin-right: 20rpx;
  display: inline-block;
  flex-shrink: 0;
  overflow: hidden;
  white-space: normal;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.topic-card:active {
  transform: scale(0.98);
}

.topic-image {
  width: 100%;
  height: 440rpx; /* 3:4 比例: 330 * 4/3 ≈ 440 */
  border-radius: 16rpx 16rpx 0 0;
}

.topic-info {
  padding: 16rpx;
}

.topic-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.topic-desc {
  display: none; /* 隐藏描述，只显示标题 */
}

/* 客户案例区域 */
.wonderful-cases-section {
  margin-bottom: 30rpx;
}

.cases-swiper {
  height: 400rpx;
  padding: 0 30rpx;
}

.case-card {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.case-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.case-name {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 16rpx;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

/* 文本省略样式 */
.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}

/* ========== 员工名片相关样式 ========== */

/* 员工标识徽章 */
.employee-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: #FF6B00;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
}

/* 设置按钮 */
.nav-setting-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.setting-icon {
  font-size: 32rpx;
  opacity: 0.6;
}

/* 员工选择弹窗遮罩 */
.employee-selector-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 弹窗容器 */
.employee-selector-popup {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* 弹窗头部 */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.popup-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
}

/* 弹窗内容 */
.popup-content {
  padding: 16rpx 0;
  max-height: 50vh;
  overflow-y: auto;
}

/* 员工列表 */
.employee-list {
  padding: 0 32rpx;
}

.employee-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  transition: background 0.2s;
}

.employee-item:active {
  background: #f5f5f5;
}

.employee-item.active {
  background: rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FF6B00;
}

.employee-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #eee;
}

.employee-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.employee-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.employee-title {
  font-size: 24rpx;
  color: #999;
}

.employee-check {
  width: 44rpx;
  height: 44rpx;
  background: #FF6B00;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 无员工提示 */
.no-employee {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.no-employee-hint {
  font-size: 24rpx;
  margin-top: 12rpx;
  color: #ccc;
}

/* 弹窗底部按钮 */
.popup-footer {
  display: flex;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.popup-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
}

.btn-reset {
  background: #f5f5f5;
  color: #666;
}

.btn-cancel {
  background: #FF6B00;
  color: #fff;
}

/* ========== 悬浮管理按钮 ========== */
.floating-admin-group {
  position: fixed;
  right: 30rpx;
  bottom: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 999;
}

.floating-admin-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: float 3s ease-in-out infinite;
}

.super-admin-btn {
  background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.35);
}

.club-admin-btn {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  box-shadow: 0 8rpx 24rpx rgba(17, 153, 142, 0.35);
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.admin-btn-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 4rpx;
}

.admin-btn-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
  line-height: 1;
  text-align: center;
  padding: 0 8rpx;
}

.activity-feed-section {
  margin: 6rpx 24rpx 0;
}

.recent-activity-banner-wrap {
  position: relative;
  margin: 2rpx 24rpx 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 130rpx;
}

.recent-activity-banner {
  width: 520rpx;
  height: 120rpx;
  max-width: 100%;
  display: block;
}

.recent-activity-banner-fallback {
  position: absolute;
  font-size: 26rpx;
  color: #6b7280;
}

.activity-tab-scroll {
  white-space: nowrap;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.06);
}

.activity-tab-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx;
}

.activity-tab-item {
  position: relative;
  min-width: 136rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  border: 1rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.activity-tab-text {
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 600;
}

.activity-tab-item-active {
  background: linear-gradient(135deg, #10d3b2 0%, #0ea5a4 100%);
  border-color: transparent;
  box-shadow: 0 10rpx 18rpx rgba(16, 211, 178, 0.28);
}

.activity-tab-item-active .activity-tab-text {
  color: #ffffff;
  font-weight: 700;
}

.activity-tab-item-active::after {
  display: none;
}

.activity-loading,
.activity-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

.activity-card {
  margin-bottom: 18rpx;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.06);
}

.activity-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.35;
  color: #111827;
  font-weight: 700;
  word-break: break-word;
}

.activity-meta-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.activity-tag {
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: #10d3b2;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.2;
}

.activity-tag-not_started {
  background: #f59e0b;
}

.activity-tag-ended {
  background: #9ca3af;
}

.activity-meta {
  font-size: 25rpx;
  color: #374151;
}

.activity-image-single-wrap {
  margin-top: 16rpx;
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.activity-image-single {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.activity-bottom-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.activity-signup {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.signup-avatar-stack {
  display: flex;
  align-items: center;
}

.signup-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  margin-left: -10rpx;
  background: #e5e7eb;
}

.signup-avatar:first-child {
  margin-left: 0;
}

.signup-count {
  font-size: 24rpx;
  color: #4b5563;
}

.activity-signup-btn {
  width: 148rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #1f2327;
  color: #10d3b2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.activity-signup-btn-not_started,
.activity-signup-btn-ended,
.activity-signup-btn-enrolled {
  background: #e5e7eb;
  color: #4b5563;
}
