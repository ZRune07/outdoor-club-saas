/* pages/super-admin/super-admin.wxss */

.super-admin-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #3b2fd8 0%, #2563eb 160rpx, #f3f6fb 360rpx, #f7f9fc 100%);
  padding-bottom: 56rpx;
}

.hero {
  padding: 48rpx 30rpx 40rpx;
  color: #ffffff;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 700;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.7;
}

.content {
  padding: 0 24rpx;
}

.summary-grid {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
}

.summary-card,
.panel-card {
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 20rpx 56rpx rgba(15, 23, 42, 0.08);
}

.summary-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 26rpx 24rpx;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
}

.summary-value {
  display: block;
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.summary-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
}

.panel-card {
  margin-top: 22rpx;
  padding: 30rpx 24rpx;
}

.panel-header {
  margin-bottom: 24rpx;
}

.panel-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.panel-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: #334155;
  font-weight: 600;
}

.input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #0f172a;
}

.primary-btn,
.primary-btn::after,
.secondary-btn,
.secondary-btn::after,
.light-btn,
.light-btn::after {
  border: none;
}

.primary-btn {
  margin: 0;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5b6cff 0%, #8b5cf6 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.result-card {
  border: 2rpx solid rgba(91, 108, 255, 0.12);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(12, 194, 153, 0.12);
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.link-box {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.link-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.link-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #0f172a;
  word-break: break-all;
}

.tip-box {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(12, 194, 153, 0.12) 0%, rgba(61, 156, 255, 0.12) 100%);
}

.tip-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #0f766e;
}

.tip-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #0f766e;
}

.action-buttons {
  margin-top: 22rpx;
  display: flex;
  gap: 18rpx;
}

.secondary-btn,
.light-btn {
  flex: 1;
  margin: 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.secondary-btn {
  background: #eef4ff;
  color: #3157f6;
}

.light-btn {
  background: #f1f5f9;
  color: #475569;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.step-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.step-index {
  width: 46rpx;
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  background: #0f172a;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 25rpx;
  color: #334155;
  line-height: 1.7;
}
