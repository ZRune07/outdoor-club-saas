.enrollments-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 24rpx 28rpx;
  box-sizing: border-box;
}

.list-loading,
.list-empty {
  margin-top: 120rpx;
  text-align: center;
  color: #6b7280;
  font-size: 26rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #374151;
  font-weight: 600;
}

.empty-sub {
  margin-top: 12rpx;
  display: block;
  font-size: 24rpx;
}

.enrollment-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 22rpx 18rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.06);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.card-title {
  flex: 1;
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
  line-height: 1.35;
}

.card-status {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #ecfeff;
  color: #0f766e;
  font-size: 22rpx;
  flex-shrink: 0;
}

.card-line {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.line-label {
  font-size: 24rpx;
  color: #6b7280;
}

.line-value {
  font-size: 24rpx;
  color: #1f2937;
  font-weight: 500;
}

.card-footer {
  margin-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
  padding-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #f97316;
}

.footer-link {
  font-size: 24rpx;
}

.footer-arrow {
  margin-left: 6rpx;
  font-size: 28rpx;
  line-height: 1;
}
