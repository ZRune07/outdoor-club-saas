<view class="page-section">
  <view wx:if="{{!loading}}">
    <block wx:if="{{cardType === 'plan'}}">
      <view class="section-grid">
        <view class="plan-card" wx:for="{{items}}" wx:key="id" bindtap="navigateToDetail" data-id="{{item.id}}">
          <view class="plan-image-wrap">
            <image class="plan-image" src="{{item.image}}" mode="aspectFill"></image>
          </view>
          <view class="plan-info">
            <text class="plan-title text-ellipsis-2">{{item.title}}</text>
          </view>
        </view>
      </view>
    </block>
    <block wx:elif="{{cardType === 'topic'}}">
      <view class="section-grid">
        <view class="topic-card card" wx:for="{{items}}" wx:key="id" bindtap="navigateToDetail" data-id="{{item.id}}">
          <image class="topic-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="topic-info">
            <text class="topic-title text-ellipsis-2">{{item.title}}</text>
          </view>
        </view>
      </view>
    </block>
    <block wx:elif="{{cardType === 'destination'}}">
      <view class="section-grid">
        <view class="destination-card" wx:for="{{items}}" wx:key="id" bindtap="navigateToDetail" data-id="{{item.id}}">
          <image class="destination-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="card-title-wrap">
            <text class="card-title text-ellipsis-2">{{item.title}}</text>
          </view>
        </view>
      </view>
    </block>
    <block wx:elif="{{cardType === 'case'}}">
      <view class="case-list">
        <view class="case-card card" wx:for="{{items}}" wx:key="id" bindtap="navigateToDetail" data-id="{{item.id}}">
          <image class="case-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="card-title-wrap">
            <text class="card-title text-ellipsis-2">{{item.title}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>
